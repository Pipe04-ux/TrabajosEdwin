print("Programa para buscar el número mayor en un vector")

vector = [14, 52, 8, 91, 4, 23, 75, 12, 66, 39]

mayor = vector[0]
i = 1

while i < 10:
   
    if vector[i] > mayor:
       
        mayor = vector[i]
        
    i = i + 1
    
print("El vector es:", vector)
print("El elemento de mayor valor es:", mayor)

print("-------------------------------------------------")
print("Fin del programa")
