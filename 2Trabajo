monto_compra = float(input("Ingrese el monto total de la compra: $"))
if monto_compra > 5000:
    porcentaje = 0.30  
elif monto_compra > 3000:
    porcentaje = 0.20  
elif monto_compra > 1000:
    porcentaje = 0.10 
else:
    porcentaje = 0.0   

descuento_ahorrado = monto_compra * porcentaje
total_a_pagar = monto_compra - descuento_ahorrado

porcentaje_pantalla = porcentaje * 100
print("---------------------------------")
print("Descuento aplicado:", porcentaje_pantalla, "%")
print("Dinero ahorrado: $", descuento_ahorrado)
print("Total neto a pagar: $", total_a_pagar)
print("---------------------------------")
