num1 = int(input("Ingrese el primer número entero: "))
num2 = int(input("Ingrese el segundo número entero: "))
if num1 < num2:
    menor = num1
    mayor = num2
else:
    menor = num2
    mayor = num1
print("Los múltiplos de 4 entre", menor, "y", mayor, "son:")
i = menor

while i <= mayor:
    if i % 4 == 0:
        print(i)
    i = i + 1
print("--------------------------------------------------")
print("Fin del programa")
